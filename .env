NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Firebase Admin
FIREBASE_PROJECT_ID=cafecash3

FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# Auth
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# Database
DB_PATH=./cafecash.db

# AI Provider (local | openai)
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_ID=

